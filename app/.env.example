# Copy to .env.local
# mock = seeded demo data, no network (default). testnet = live Stellar Testnet.
NEXT_PUBLIC_DEMO_MODE=mock
# Paste after ./scripts/deploy-testnet.sh
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org:443
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# Testnet USDC Stellar Asset Contract (SAC) — verify before use
NEXT_PUBLIC_USDC_SAC=
